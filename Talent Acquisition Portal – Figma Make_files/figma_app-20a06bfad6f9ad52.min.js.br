order around these chits. However, Chrome\n      doesn't support sub-pixel borders and Safari doesn't support sub-pixel box-shadows,\n      so we use this hack where we draw a 1px box at twice the size and then scale it down. */\n  top: -50%;\n  left: -50%;\n  right: -50%;\n  bottom: -50%;\n  box-shadow: inset 0 0 0 1px var(--color-border);\n  transform-origin: center center;\n  transform: scale(0.5);\n}\n\n[data-fpl-version='ui3'] .chit--chitBorder---ff5t, :where([data-fpl-ui3-override]) .chit--chitBorder---ff5t {\n    /* Border radius is a percentage instead of an actual value since we render chits\n    at various sizes (see: gridVariableChit), this ensures its always the right radius no matter the size */\n    border-radius: 20%;\n}\n\n/* The above fix looks good everywhere except in FireFox on low-density displays. In that\n   case, we just throw our hands in the air and render a 1px border around the chit. */\n\n@media screen and (max-resolution: 1.5dppx) {\n  @supports (-moz-appearance: none) {\n    .chit--chitBorder---ff5t {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      box-shadow: inset 0 0 0 1px var(--color-border);\n      transform: none;\n    }\n  }\n}\n",X3:"chit--chitThumbnail--s-Jem",Xi:"chit--chitShaderIcon--MNStG",f$:"chit--chitAlpha--xQ5s0",lo:"chit--chitBorder---ff5t",x7:"chit--chit---D2JR"})},886287(e,t,r){r.d(t,{},{$:"colors_inspect_panel--gradientVariableSingleRow--X6dgo",$f:"colors_inspect_panel--propertyColorRowTallUI3--TLkdk colors_inspect_panel--_propertyColorRow--BnwRn inspection_property--tallPropertyRow--0tB0Q inspection_property--_basePropertyRow--H4A-x inspection_property--tallRow--4VFZa",As:"colors_inspect_panel--paintColor--WwsAV ellipsis--ellipsis--IdJAr ellipsis--ellipsis--IdJAr",Bx:"colors_inspect_panel--deletedIcon--62bEd",DQ:"colors_inspect_panel--rawColorUI3Hoverable--UoinF",Gz:"colors_inspect_panel--paintIcon---6IgI",K5:"colors_inspect_panel--propertyColorRowTall---HNAm colo