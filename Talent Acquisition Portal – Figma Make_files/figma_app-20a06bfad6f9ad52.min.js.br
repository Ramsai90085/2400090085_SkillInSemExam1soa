),(0,o.jsxs)("li",{children:[(0,o.jsx)("strong",{children:"AI."})," FigJam\u2019s Generate tool saves time by creating mind maps, flowcharts, and other diagrams based on the given prompt."," "]}),(0,o.jsxs)("li",{children:[(0,o.jsx)("strong",{children:"Templates."})," FigJam has over 300 pre-made templates, from meeting notes and brainstorming to strategic planning and diagramming. These templates give you a starting point to organize ideas."]})]})]}),(0,o.jsxs)("details",{className:t6,children:[(0,o.jsxs)("summary",{children:[(0,o.jsx)("span",{className:t7,id:"31-how-does-the-select-button-work",children:"How does the Select button work?"}),(0,o.jsx)(t3.k,{className:t9})]}),(0,o.jsxs)("p",{children:["When opening a FigJam whiteboard, the cursor that pops up by default is the Select tool. The Select tool allows you to select, move, and resize any objects on your board. Simply click on the object to select it and change its properties. To select multiple objects at once, click and drag your cursor around the items you want to select. You can also select an object, then hold down the Shift key on your keyboard and click any other items you want to select."," "]})]}),(0,o.jsxs)("details",{className:t6,children:[(0,o.jsxs)("summary",{children:[(0,o.jsx)("span",{className:t7,id:"33-how-do-i-use-the-marker-tool",children:"How do I use the Marker tool?"}),(0,o.jsx)(t3.k,{className:t9})]}),(0,o.jsx)("p",{children:"To use the Marker tool on your online whiteboard, click the marker icon on the bottom toolbar. Once selected, you can change the color and thickness to your liking. Use the marker to sketch wireframes, annotate designs, create doodles, or take meeting notes directly on your whiteboard."})]}),(0,o.jsxs)("details",{className:t6,children:[(0,o.jsxs)("summary",{children:[(0,o.jsx)("span",{className:t7,id:"34-what-are-figjams-ai-online-whiteboard-features",children:"What are FigJam\u2019s AI online whiteboard features?"}),(0,o.jsx)(t3.k,{className:t9})]}),(0,o.jsxs)("p